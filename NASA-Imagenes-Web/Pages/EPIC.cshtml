 @page
@model EPICModel

@{
    ViewData["Title"] = "Imagenes EPIC (Tierra)";
}

@if (Model.EpicImages == null || !Model.EpicImages.Any())
{
    <div class="alert alert-warning text-center">

        🚨 No se pudieron cargar imágenes EPIC.
        Puede que NASA esté limitando requests.

    </div>

    return;
}

